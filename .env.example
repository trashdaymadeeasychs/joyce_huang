# ─── Required ──────────────────────────────────────────
# Neon Postgres connection string (use the pooled URL)
DATABASE_URL=postgres://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT signing secret — 64+ random characters (e.g. `openssl rand -hex 48`)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ─── Recommended ───────────────────────────────────────
NODE_ENV=production

# Receipt storage backend: "blob" (Netlify Blobs, default) or "db" (data: URLs)
UPLOAD_STORAGE_MODE=blob

# ─── Seed only ─────────────────────────────────────────
# Initial password for seeded admin/manager/employee accounts
SEED_PASSWORD=ChangeMe123!
