# ─── Required ──────────────────────────────────────────
# Neon Postgres connection string — use the POOLED connection URL from
# your Neon dashboard (Settings → Connection Details → Pooled connection)
DATABASE_URL=postgres://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Recommended ───────────────────────────────────────
NODE_ENV=production

# Receipt storage backend: "blob" (Netlify Blobs, default) or "db" (data: URLs)
UPLOAD_STORAGE_MODE=blob

# ─── Notes ─────────────────────────────────────────────
# JWT_SECRET is NOT required — this app uses Netlify's site-wide password
# for access control (single-user mode). No in-app login.
#
# Site password: set in Netlify → Site configuration → Site password
